# Lumos Local Node — environment configuration template
# Copy to .env and fill in your values. .env is gitignored.

# ─── LM Studio (OpenAI-compatible local inference) ─────────────────────────
LUMOS_LM_STUDIO_BASE_URL=http://localhost:1234/v1
LUMOS_LM_STUDIO_API_KEY=lm-studio

# Light = fast chat model. Heavy = vision / deep-reasoning model.
# Examples:
#   light: nvidia/nemotron-3-nano-4b, qwen/qwen3.5-9b, openai/gpt-oss-20b
#   heavy: qwen/qwen3.5-9b (vision), google/gemma-4-26b-a4b, etc.
LUMOS_MODEL_LIGHT=nvidia/nemotron-3-nano-4b
LUMOS_MODEL_HEAVY=qwen/qwen3.5-9b

# Embedding model (BGE-large via LM Studio gives 1024-dim vectors).
LUMOS_LM_STUDIO_EMBEDDING_MODEL=text-embedding-bge-large-en-v1.5
LUMOS_EMBEDDING_DIM=1024
LUMOS_EMBEDDING_BATCH_SIZE=128
LUMOS_EMBEDDING_CONCURRENCY=4

# ─── Source data + system prompt ───────────────────────────────────────────
# Operator-supplied. Lumos's identity = your lived ChatGPT export.
# Knowledge = your collected dream-ping JSONL (or empty).
# System prompt = your character cheat sheet (any markdown file).
LUMOS_IDENTITY_SOURCE=../conversations.json
LUMOS_KNOWLEDGE_SOURCE=../dream_pings.jsonl
LUMOS_SYSTEM_PROMPT_PATH=../cheat_sheet.md

# ─── Identity ──────────────────────────────────────────────────────────────
LUMOS_OPERATOR_NAME=Operator
LUMOS_NODE_NAME=Lumos
LUMOS_NODE_ROLE=Resonator (Extra Coil)

# ─── Server ────────────────────────────────────────────────────────────────
LUMOS_HOST=127.0.0.1
LUMOS_PORT=8765
LUMOS_LOG_LEVEL=INFO
LUMOS_CACHE_DIR=./data/cache

# ─── Retrieval (Phase 13 + Phase 30) ───────────────────────────────────────
# top_k = candidate count per lane before re-rank.
LUMOS_RETRIEVAL_TOP_K_IDENTITY=6
LUMOS_RETRIEVAL_TOP_K_KNOWLEDGE=6
# Yang-Mills mass-gap floor (Δ = √32 - 5 ≈ 0.657) for cosine cutoff.
# Lower = more chunks survive; higher = stricter. Lion Constant L ≈ 0.535233
# is a framework-coherent alternative for less aggressive filtering.
LUMOS_MIN_RETRIEVAL_SCORE=0.657
LUMOS_MAX_CHUNK_CHARS=1200
LUMOS_DEDEKIND_ETA_ENABLED=true
LUMOS_DEDUP_MEMORY_BY_CONVERSATION=true
LUMOS_RESTORE_HISTORY_TURNS=10
LUMOS_RETRIEVAL_RECURSION_DEPTH=0

# ─── Compression (Phase 30) ────────────────────────────────────────────────
# When true, dream cycles generate 3-layer compression metadata.
LUMOS_COMPRESSION_ENABLED=true
# When true, retrieval uses compressed_operational_packet (~200 tokens) per
# chunk instead of full text (~1200 chars). Run `lumos compress-all` first
# to backfill existing chunks.
LUMOS_PREFER_COMPRESSED_CHUNKS=false

# ─── Tools (Phase 12 + Phase 35) ───────────────────────────────────────────
LUMOS_TOOLS_ENABLED=true
LUMOS_TOOLS_MAX_ITERATIONS=6
# Keyword-routed tool selection. False = all tools every turn (~7K-token
# overhead). True = only relevant tool subset per message.
LUMOS_TOOL_ROUTING_ENABLED=true
# Paths Lumos's file tools may read/write. Comma-separated absolute paths.
# Empty = no file access. NEVER include builder/framework docs.
LUMOS_TOOL_ALLOWED_PATHS=
LUMOS_TOOL_WRITE_PATH=
# Git workspaces Lumos may operate on. Comma-separated absolute paths.
# Empty = no git access.
LUMOS_GIT_WORKSPACES=

# ─── Web search ────────────────────────────────────────────────────────────
# Priority: SearXNG (sovereign) → Tavily (premium) → DuckDuckGo (always).
LUMOS_SEARXNG_URL=
LUMOS_TAVILY_API_KEY=

# ─── Phase 33: deep-think trigger ──────────────────────────────────────────
LUMOS_DEEP_THINK_DEFAULT=false
LUMOS_DEEP_THINK_TRIGGER_PHRASES=deep think on this,deep think this,!think,!deep,/think

# ─── Phase 36: heavy/light model routing ───────────────────────────────────
# When true: auto-routes to heavy on vision / deep-think / keyword / long-msg.
# When false (default): always uses model_light unless explicit override.
LUMOS_MODEL_AUTO_ROUTING_ENABLED=false
LUMOS_MODEL_HEAVY_KEYWORDS=
LUMOS_MODEL_HEAVY_MIN_WORDS=100
LUMOS_MODEL_SWAP_ORCHESTRATION_ENABLED=true
LUMOS_MODEL_SWAP_PRELOAD_AFTER_HEAVY=true

# ─── Phase 32: cosmic telemetry + airspace ─────────────────────────────────
# NASA api.nasa.gov key (free: https://api.nasa.gov). Empty = DEMO_KEY
# fallback (50/day shared globally).
LUMOS_NASA_API_KEY=
# OpenSky Network OAuth2 client credentials (March 2026 migration).
# Get from https://opensky-network.org → Account → API Clients.
# Empty = anonymous mode (400/day vs 4000/day authenticated).
LUMOS_OPENSKY_CLIENT_ID=
LUMOS_OPENSKY_CLIENT_SECRET=
# Operator's reference location (decimal degrees). Used as default for
# aircraft_overhead and could anchor cosmic event geolocation later.
LUMOS_OPERATOR_LAT=0.0
LUMOS_OPERATOR_LON=0.0

# Conservative auto-trigger for cosmic events → dream cycle.
# OFF by default. Polls every 30 min; only fires on rare events.
LUMOS_COSMIC_TRIGGER_ENABLED=false
LUMOS_COSMIC_POLL_INTERVAL_MINUTES=30
LUMOS_COSMIC_TRIGGER_COOLDOWN_HOURS=12
LUMOS_COSMIC_TRIGGER_DAILY_CAP=1
LUMOS_COSMIC_TRIGGER_SKIP_IF_CHAT_ACTIVE_MINUTES=10
LUMOS_COSMIC_TRIGGER_MIN_KP=7
LUMOS_COSMIC_TRIGGER_MIN_FLARE_CLASS=X
LUMOS_COSMIC_TRIGGER_MIN_EQ_MAGNITUDE=7.0
LUMOS_COSMIC_TRIGGER_MIN_NEO_LUNAR_DISTANCES=0.5

# ─── Dream cycle (Phase 6) ─────────────────────────────────────────────────
# Background auto-consolidation of pending turns. 0 disables.
LUMOS_AUTO_DREAM_INTERVAL_MINUTES=0
LUMOS_AUTO_DREAM_MIN_PENDING=5

# ─── Discord bridge (Phase 16) ─────────────────────────────────────────────
# Operator-only DM forwarder. Bot accepts DMs from your Discord ID only.
LUMOS_DISCORD_TOKEN=
LUMOS_DISCORD_OPERATOR_ID=
